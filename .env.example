PORT=3000
JWT_SECRET=change-this-secret-in-local-env
JWT_EXPIRES_IN=8h

POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=knowbase
POSTGRES_USER=knowbase
POSTGRES_PASSWORD=knowbase

MONGODB_URI=mongodb://knowbase:knowbase@localhost:17017/knowbase?authSource=admin

RUSTFS_ENDPOINT=localhost
RUSTFS_PORT=19000
RUSTFS_USE_SSL=false
RUSTFS_ACCESS_KEY=knowbaseadmin
RUSTFS_SECRET_KEY=knowbaseadmin
RUSTFS_BUCKET=knowbase-documents

PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

RABBITMQ_URL=amqp://knowbase:knowbase@localhost:15672
RABBITMQ_PREFETCH=1
RABBITMQ_CONNECT_TIMEOUT_MS=5000
RABBITMQ_CONFIRM_TIMEOUT_MS=10000
RABBITMQ_RECONNECT_INTERVAL_MS=5000
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
PIPELINE_MAX_ATTEMPTS=3
PIPELINE_RETRY_DELAY_MS=5000
PIPELINE_WORKERS_ENABLED=true

ELASTICSEARCH_NODE=http://localhost:19200
ELASTICSEARCH_DOCUMENT_INDEX=kh_document
ELASTICSEARCH_CHUNK_INDEX=kh_chunk
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_EMBEDDING_DIMENSIONS=768
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_BATCH_CHARACTERS=24000
RAG_EMBEDDING_CONCURRENCY=2
RAG_EMBEDDING_TIMEOUT_MS=60000
ES_BULK_MAX_CHUNKS=200
ES_BULK_MAX_BYTES=5242880
INGESTION_CACHE_TTL_DAYS=30
# Set an immutable model revision/digest to enable persistent vector reuse.
EMBEDDING_MODEL_REVISION=

EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:0.5b
OLLAMA_CHAT_TEMPERATURE=0
OLLAMA_CHAT_SEED=42
OLLAMA_KG_MODEL=qwen2.5:0.5b
OLLAMA_KG_TEMPERATURE=0
OLLAMA_KG_SEED=42

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=

NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=knowbase

LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:13000
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_ENVIRONMENT=local
LANGFUSE_RELEASE=knowbase-local

# Parsing engine: native or mineru (MinerU v4 Tasks API)
DOCUMENT_PARSER=mineru
INGESTION_ASYNC_ENABLED=true
INGESTION_PARSE_CONCURRENCY=1
INGESTION_MAX_FILE_BYTES=104857600
INGESTION_MAX_CONTENT_BYTES=4194304
INGESTION_MAX_PAGES=1000
INGESTION_TASK_LEASE_MS=120000
INGESTION_TASK_MAX_ATTEMPTS=3
MINERU_BASE_URL=http://127.0.0.1:8000
MINERU_API_KEY=
MINERU_TIER=flash
MINERU_TIMEOUT_MS=600000
MINERU_POLL_MS=1000
MINERU_RESULT_MAX_BYTES=67108864
# Explicit extra origins for signed upload/result URLs (comma-separated)
MINERU_TRANSFER_ORIGINS=

# Only retired, committed generations tracked by this version are collected.
INDEX_GENERATION_GC_ENABLED=false
INDEX_GENERATION_RETENTION_HOURS=24
