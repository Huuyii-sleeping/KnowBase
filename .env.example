PORT=3000
JWT_SECRET=change-this-secret-in-local-env
JWT_EXPIRES_IN=8h

POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=knowbase
POSTGRES_USER=knowbase
POSTGRES_PASSWORD=knowbase

MONGODB_URI=mongodb://knowbase:knowbase@localhost:17017/knowbase?authSource=admin

RUSTFS_ENDPOINT=localhost
RUSTFS_PORT=19000
RUSTFS_USE_SSL=false
RUSTFS_ACCESS_KEY=knowbaseadmin
RUSTFS_SECRET_KEY=knowbaseadmin
RUSTFS_BUCKET=knowbase-documents

PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

RABBITMQ_URL=amqp://knowbase:knowbase@localhost:15672
RABBITMQ_PREFETCH=1
RABBITMQ_REQUEUE_ON_ERROR=false
PIPELINE_WORKERS_ENABLED=true

ELASTICSEARCH_NODE=http://localhost:19200
ELASTICSEARCH_DOCUMENT_INDEX=kh_document
ELASTICSEARCH_CHUNK_INDEX=kh_chunk
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_EMBEDDING_DIMENSIONS=768

EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:0.5b
OLLAMA_CHAT_TEMPERATURE=0
OLLAMA_CHAT_SEED=42

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=

NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=knowbase

LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:13000
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_ENVIRONMENT=local
LANGFUSE_RELEASE=knowbase-local
